{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyops-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "../mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/v2/*"],
  },
}
